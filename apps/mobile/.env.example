# Copy to .env.local and fill in real values. Never commit the real file.

# Clerk (replaces Supabase Auth — PROJECT_MEMORY.md §6.4). Get this from
# your Clerk Dashboard > API Keys, after creating a Clerk application.
# Apple/Google sign-in also need to be enabled as SSO connections in the
# Clerk Dashboard itself — having this key alone isn't enough for those two.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Neon Postgres connection string — not consumed by the mobile app directly
# (it goes through the Vercel API layer per Backend Architecture), listed
# here so all required secrets for this milestone are in one place.
DATABASE_URL=

# Base URL of the deployed apps/web Vercel project — e.g.
# https://noivos-pb6p.vercel.app or a Preview deployment's URL while
# developing. Added 2026-09-25 wiring the first real (non-mock) data into
# apps/mobile: unlike apps/web (same-origin, cookie-based Clerk session),
# this app is always a separate origin from the API it calls, so every
# request goes to `${EXPO_PUBLIC_API_BASE_URL}${path}` with a Clerk session
# token attached explicitly as a Bearer header instead of a cookie — see
# src/lib/api.ts. Leave unset to keep running on mock data only, same
# honest "not configured yet" posture as every other feature flag in this
# app (apiConfigured() in src/lib/api.ts).
EXPO_PUBLIC_API_BASE_URL=
